{
    "name": "@tea-pos/api",
    "private": true,
    "scripts": {
        "build": "go build ./...",
        "lint": "test -z \"$(gofmt -l .)\" || (gofmt -l . && exit 1) && go vet ./... && go vet -tags integration ./tests/...",
        "typecheck": "go build ./...",
        "test": "go test ./...",
        "test:integration": "go test -tags integration -count=1 ./tests/...",
        "generate": "go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1 generate",
        "generate:check": "go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1 diff",
        "db:schema": "infisical run --env=staging --path=/app -- bash scripts/db-schema.sh"
    }
}
