{
    "name": "tea-pos-v2",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.7",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "turbo run build",
        "seller": "pnpm --filter @tea-pos/seller dev",
        "backoffice": "infisical run --env=staging --path=/app -- bash scripts/dev.sh backoffice",
        "backoffice:prod": "READ_ONLY=1 infisical run --env=prod --path=/app -- bash scripts/dev.sh backoffice",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "bundle-size": "node scripts/bundle-size.mjs",
        "bench": "node scripts/bench.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "10.13.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "prettier": "3.9.10",
        "puppeteer-core": "25.13.0",
        "railway": "3.16.0",
        "turbo": "2.11.9",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.0"
    }
}
