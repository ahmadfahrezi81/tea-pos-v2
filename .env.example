# Copy to .env.local for the laptop. Real values live in Infisical (staging, prod).

# HTTP port for api and realtime
PORT=8080
# local, staging or prod; on every log line
ENV=local
# debug, info, warn or error
LOG_LEVEL=info
# Seconds in-flight requests get to finish on SIGTERM
SHUTDOWN_TIMEOUT_SECONDS=20
# Seconds before a request's context is cancelled
REQUEST_TIMEOUT_SECONDS=10
# Supabase session pooler (port 5432); on the laptop, infisical run --env=staging --path=/app supplies it
DATABASE_URL=
# Fixed pool size: api 8, worker 4, realtime 2 (set in railway.ts)
DB_MAX_CONNS=4
